# Copy to .env. setup.sh creates one for you.
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Behind Caddy/nginx: lets login rate limiting see the real visitor IP
TRUST_PROXY=1
# HTTPS=0 only if you run with DEBUG=0 over plain http for a test
HTTPS=1
# Optional PostgreSQL (SQLite is used when POSTGRES_DB is empty)
# For Vercel/Neon, set DATABASE_URL to the Neon connection string instead.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Optional persistent media storage (Cloudinary). Keep the URL secret.
CLOUDINARY_URL=
# Order and contact email notifications (use a newly generated mail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Paystack: begin with test keys; switch PAYSTACK_MODE to live only with live secret keys.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
